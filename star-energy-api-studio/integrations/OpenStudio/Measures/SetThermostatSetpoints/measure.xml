  <class_name>SetThermostatSetpoints</class_name>
  <display_name>Set Thermostat Setpoints</display_name>
  <description>Applies constant heating and cooling setpoints to every thermostat in the model.</description>
  <modeler_description>Replaces thermostat schedules with constant schedules so the dead band is defined by the arguments.</modeler_description>
  <arguments>
    <argument><name>heating_setpoint_c</name><display_name>Heating setpoint (C)</display_name><type>Double</type><required>true</required><model_dependent>false</model_dependent><default_value>22.0</default_value></argument>
